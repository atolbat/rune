{
  "name": "rune",
  "version": "0.1.0",
  "private": true,
  "description": "A unified WebGL2/WebGPU renderer: regl-style declarative commands, signal-based reactivity, tapes as the currency of a frame",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.mjs",
    "demo": "bun scripts/build.mjs && bun scripts/serve-demo.mjs",
    "demo:smoke": "bun scripts/demo-smoke.mjs",
    "test": "bun test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.1.0",
    "@webgpu/types": "^0.1.72",
    "eslint": "^10.9.1",
    "playwright": "1.57.0",
    "pngjs": "7",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.69.0"
  }
}
